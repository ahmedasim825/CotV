# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Milo PC agent config — holds the shared secret for the Windows bridge.
tools/milo_pc_agent/milo_agent.toml

# Milo API keys for local --dart-define-from-file builds. Never commit.
milo_keys.json

# Local MSIX code-signing certificate and its password. Never commit.
certs/

# Kokoro's ONNX weights, fetched by hand from the kokoro-onnx releases.
# ~350MB of downloaded artifact, and past GitHub's file limit — the agent
# reports them missing and falls back to the OS voice when they are not here.
tools/milo_pc_agent/models/
